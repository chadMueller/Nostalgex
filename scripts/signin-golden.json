    {
      "raw": "192.0.2.10:8096",
      "out": [
        "http://192.0.2.10:8096"
      ]
    },
    {
      "raw": "nas.local",
      "out": [
        "http://nas.local:8096",
        "http://nas.local"
      ]
    },
    {
      "raw": "http://nas.local/jellyfin",
      "out": [
        "http://nas.local/jellyfin"
      ],
      "about": "a path means a proxy, so no port is added"
    },
    {
      "raw": "192.0.2.10 : 8096",
      "out": [
        "http://192.0.2.10:8096"
      ],
      "about": "spaces anywhere are dropped"
    },
    {
      "raw": "jellyfin.example.com",
      "defaultScheme": "https",
      "out": [
        "https://jellyfin.example.com"
      ],
      "about": "the hosted page defaults to https and never adds a port to https"
    },
    {
      "raw": "http://192.0.2.10",
      "defaultScheme": "https",
      "out": [
        "http://192.0.2.10:8096",
        "http://192.0.2.10"
      ],
      "about": "a typed scheme wins over the default"
    },
    {
      "raw": "fe80::1",
      "out": [
        "http://[fe80::1]:8096",
        "http://[fe80::1]"
      ]
    },
    {
      "raw": "[fe80::1]:8920",
      "out": [
        "http://[fe80::1]:8920"
      ]
    },
    {
      "raw": "user@nas.local:8096",
      "out": [
        "http://user@nas.local:8096"
      ]
    }
