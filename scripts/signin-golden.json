      "name": "bare-address-finds-jellyfin-on-8096-and-opens-on-quick-connect",
      "address": "192.0.2.10",
      "routes": {
        "http://192.0.2.10:8096/System/Info/Public": [
          200,
          "{\"ServerName\":\"Living Room\",\"ProductName\":\"Jellyfin Server\",\"Id\":\"jf1\"}"
        ],
        "http://192.0.2.10:8096/QuickConnect/Enabled": [
          200,
          "true"
        ],
        "http://192.0.2.10:8096/Users/Public": [
          200,
          "[]"
        ]
      },
      "out": {
        "kind": "jellyfin",
        "url": "http://192.0.2.10:8096",
        "name": "Living Room",
        "quickConnectEnabled": true,
        "users": [],
        "preferred": "quickConnect"
      }
    },
