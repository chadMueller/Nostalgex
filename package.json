    "build:tuner": "vite build --mode tuner",
    "build:selfhost": "vite build --mode selfhost --outDir dist-selfhost",
    "preview": "vite preview",
    "snapshot": "node --env-file-if-exists=.env scripts/devtools/build-snapshot.mjs",
    "devtools": "node --env-file-if-exists=.env scripts/devtools/server.mjs",
    "devtools:full": "npm run snapshot && npm run devtools",
    "changelog:discord": "node scripts/post-changelog-discord.mjs",
    "changelog:check": "node scripts/changelog-check.mjs",
    "test:franchises": "node scripts/nostalgex-franchise-smoke.mjs",
    "test:watch-state": "node scripts/nostalgex-watch-state-smoke.mjs",
    "test:jellyfin-urls": "node scripts/nostalgex-jellyfin-urls-smoke.mjs",
    "test:jellyfin-quick-connect": "node scripts/nostalgex-jellyfin-quick-connect-smoke.mjs",
    "test:signin": "node scripts/nostalgex-signin-smoke.mjs",
    "test:tuner-isolation": "node scripts/tuner-isolation-check.mjs",
    "test:tuner-isolation:builds": "node scripts/tuner-isolation-check.mjs --builds",
    "test:jellyfin-subtitles": "node scripts/nostalgex-jellyfin-subtitles-smoke.mjs",
    "test:language-match": "node scripts/nostalgex-language-match-smoke.mjs",
    "media:measure": "node scripts/measure-media.mjs",
    "test:reporting-controls": "node scripts/playback-reporting-controls-smoke.mjs"
