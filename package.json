    "bundles:render:strict": "node scripts/build-bundles.mjs --strict",
    "selfhost:render": "node scripts/render-self-host.mjs",
    "selfhost:render:check": "node scripts/render-self-host.mjs --check",
    "roku:render": "node scripts/render-roku.mjs",
    "roku:render:check": "node scripts/render-roku.mjs --check",
    "channels:doc": "node scripts/render-channels-doc.mjs",
    "channels:doc:check": "node scripts/render-channels-doc.mjs --check",
    "test:filter": "node scripts/nostalgex-filter-smoke.mjs",
    "test:library-load": "node scripts/nostalgex-library-load-smoke.mjs",
    "test:season": "node scripts/nostalgex-season-smoke.mjs",
    "test:filter-golden": "node scripts/nostalgex-filter-golden-smoke.mjs",
