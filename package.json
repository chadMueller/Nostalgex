    "test:empty-lineup": "node scripts/empty-lineup-browser-smoke.mjs",
    "test:utf8-repair": "node scripts/nostalgex-utf8-repair-smoke.mjs",
    "test:plex-bad-byte": "node scripts/plex-bad-byte-browser-smoke.mjs",
    "test:stream-quality": "node scripts/nostalgex-stream-quality-smoke.mjs",
    "test:stream-quality:browser": "node scripts/stream-quality-browser-smoke.mjs",
