  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "gray-matter": "^4.0.3",
    "hls.js": "1.5.17",
    "marked": "^18.1.0",
    "qrcodejs": "1.0.0",
    "vite": "^7.1.0"
  }
