<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen banner (320 x 180 dp): the wordmark on black. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:left="40dp" android:right="40dp" android:gravity="center_vertical|fill_horizontal">
        <bitmap android:gravity="center" android:src="@drawable/wordmark" />
    </item>
</layer-list>
