<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
  <interface>
    <!-- Set by source/main.brs from a launch or roInput deep link. -->
    <field id="deepLink" type="assocarray" alwaysNotify="true" onChange="onDeepLink" />
    <!-- Set when the app closes itself (Back on the guide, once the server
         stream is stopped); source/main.brs returns on it. -->
    <field id="leave" type="boolean" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util/Values.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/PlexApi.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/LibrarySnapshot.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/ServerKind.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x0B0E11FF" />
    <Poster id="title" uri="pkg:/images/logo.png" translation="[660,220]" width="600" height="79" />
    <Label id="prompt" text="" translation="[160,400]" width="1600" horizAlign="center" wrap="true" color="0xFFFFFFFF" font="font:MediumSystemFont" />
    <Label id="hint" text="" translation="[160,880]" width="1600" horizAlign="center" wrap="true" color="0x8A9099FF" font="font:SmallSystemFont" />
  </children>
</component>
