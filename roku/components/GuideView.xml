<?xml version="1.0" encoding="utf-8"?>
<!-- The guide, laid out after the Nostalgex Apple TV app (TunerView,
     InfoPanelView, ChannelGuideView): the focused channel's airing top left,
     the live preview top right, the two-hour grid below. The panel comes
     after the video so that RETRO MODE's 4:3 crop can run under it. Measurements are the
     tvOS app's, which draws 1:1 on a 1920x1080 screen. -->
<component name="GuideView" extends="Group">
  <interface>
    <field id="guide" type="assocarray" onChange="onGuide" />
    <!-- For MainScene: "rebuild" after package changes, or "signOut". -->
    <field id="action" type="string" alwaysNotify="true" />
    <!-- A package switched in Settings, saved: MainScene asks the library
         task to build for it, and hands back bundleBuilt (see LibraryTask). -->
    <field id="bundleRequest" type="boolean" alwaysNotify="true" />
    <!-- Settings closed: MainScene asks the library task for its re-check
         now, so a WATERSHED switch reschedules at once (LibraryTask.reschedule). -->
    <field id="reschedule" type="boolean" alwaysNotify="true" />
    <field id="bundleBuilt" type="string" alwaysNotify="true" onChange="onBundleBuilt" />
    <!-- Each channel's matching titles from the library task (its
         matchCounts), for Settings' WHY ARE SOME CHANNELS MISSING? -->
    <field id="matchCounts" type="assocarray" onChange="onMatchCounts" />
    <!-- A deep link from MainScene ({ contentId, mediaType }): tune that
         channel fullscreen, or in a sideloaded build play "item:<id>". -->
    <field id="deepLink" type="assocarray" alwaysNotify="true" onChange="onDeepLink" />
    <!-- Set before the first guide, after a full rebuild from Settings: the
         channel to tune and focus instead of the top row, by id. -->
    <field id="resumeId" type="string" />
    <!-- RESCAN LIBRARY was pressed in Settings (MainScene reads the library
         again behind the guide); libraryBusy is true while a load runs, so
         the row says UPDATING. -->
    <field id="rescanRequest" type="boolean" alwaysNotify="true" />
    <field id="libraryBusy" type="boolean" value="false" onChange="onLibraryBusy" />
    <!-- A guide from the cold-boot seed (source/guide/ColdBootSeed.brs) ran
         out of airings before the library finished loading: MainScene puts
         the loading screen back. -->
    <field id="seedEnded" type="boolean" alwaysNotify="true" />
    <!-- The id of the channel tuned, as a string, or "" (resumeId's source). -->
    <function name="tunedChannelId" />
    <!-- True while the viewer is on the guide itself: no full screen, Settings or prompt, no sleep prompt. The
         safe moment to rebuild the channels (MainScene, a new channels.json). -->
    <function name="onGuideScreen" />
    <!-- The loading pattern (source/guide/LoadState.brs). loadInfo is what the
         scan has read so far ({ titles, of, name }); readyTitles is set when a
         load finished (GUIDE READY: n TITLES); loadError is why a switch could
         not read the library. enterChanging clears the rows for a server or
         library switch and shows CHANNEL GUIDE IS CHANGING in their place. -->
    <field id="loadInfo" type="assocarray" onChange="onLoadInfo" />
    <field id="readyTitles" type="integer" value="0" alwaysNotify="true" onChange="onReadyTitles" />
    <field id="loadError" type="string" value="" onChange="onLoadError" />
    <function name="enterChanging" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util/Values.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/ColdBootSeed.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/LoadState.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/StreamQuality.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/BundleChoices.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/GuideNav.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/TuneQueue.brs" />
  <script type="text/brightscript" uri="pkg:/source/schedule/LocalTime.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/Advance.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/Fallback.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/PlaybackInfo.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/SleepTimer.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/DeepLink.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/RetroMode.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/Watershed.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/GuideText.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/GuideTimeout.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/GuideTimeCursor.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/GuideStripes.brs" />
  <script type="text/brightscript" uri="pkg:/source/ui/Tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/NowPlayingLayout.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/SeasonalPrompt.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/PlexApi.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/DirectPlay.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/PlexPlayback.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/PlexPoster.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/ServerKind.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/MediaBrowserApi.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/MediaBrowserPlayback.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/PlaybackReport.brs" />
  <script type="text/brightscript" uri="pkg:/source/subtitles/SubtitleSelection.brs" />
  <script type="text/brightscript" uri="pkg:/source/subtitles/SubtitleSettings.brs" />
  <script type="text/brightscript" uri="pkg:/source/subtitles/Srt.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/RescanInfo.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/PlaybackVerdict.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/LastChannel.brs" />
  <script type="text/brightscript" uri="pkg:/source/weather/WeatherZones.brs" />
  <script type="text/brightscript" uri="pkg:/source/weather/Weather.brs" />
  <script type="text/brightscript" uri="pkg:/source/weather/WeatherStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/GuideView.brs" />
  <children>
    <Rectangle id="screen" width="1920" height="1080" color="0x000000FF" />
    <Rectangle id="videoBg" translation="[1180,0]" width="740" height="555" color="0x05050DFF" />
    <Video id="video" translation="[1180,0]" width="740" height="555" />
    <!-- CH 299 LOCAL WEATHER (WeatherView): a 1920 x 1080 picture scaled into the preview box, or to the whole screen
         in full screen, in the place of the video while that channel is tuned. -->
    <WeatherView id="weather" visible="false" translation="[1180,69]" scale="[0.3854,0.3854]" />
    <!-- WATERSHED hold keep-alive (#190): a 4 px black clip, muted and looping, only while a held channel has
         nothing airing, so the stick keeps running the app (it stops one that plays no video for ~10 minutes). -->
    <Video id="keepVideo" translation="[0,0]" width="4" height="4" />
    <!-- A forced subtitle line the app draws itself (#237, drawForcedSub): under
         the CRT overlay, as part of the picture. The dark copy behind is its edge. -->
    <Group id="forcedSub" visible="false">
      <Label id="forcedSubEdge" horizAlign="center" vertAlign="bottom" wrap="true" color="0x000000FF" />
      <Label id="forcedSubText" horizAlign="center" vertAlign="bottom" wrap="true" color="0xFFFFFFFF" />
    </Group>
    <!-- RETRO MODE's CRT overlay (CRTOverlayView): scanlines and vignette.
         Images from scripts/look-images.py. -->
    <Group id="crt" translation="[1180,0]">
      <Poster id="scanlines" uri="pkg:/images/look/scanlines.png" width="740" height="555" />
      <Poster id="vignette" uri="pkg:/images/look/vignette.png" width="740" height="555" />
    </Group>
    <Group id="haze" visible="false" opacity="0">
      <Rectangle id="hazeBg" translation="[1180,0]" width="740" height="555" color="0x000000FF" />
      <Poster id="snow" uri="pkg:/images/look/snow_0.png" translation="[1180,0]" width="740" height="556" opacity="0.32" />
      <Label id="hazeText" translation="[1180,261]" width="740" horizAlign="center" />
    </Group>
    <Timer id="infoPosterTimer" repeat="false" duration="0.25" />
    <Timer id="readyTimer" repeat="false" duration="4" />
    <!-- The loading block's indicator: a cyan bar sliding back and forth. -->
    <Animation id="loadSlide" duration="1.4" repeat="true" easeFunction="inOutQuad">
      <Vector2DFieldInterpolator key="[0.0, 0.5, 1.0]" keyValue="[[0.0, 0.0], [240.0, 0.0], [0.0, 0.0]]" fieldToInterp="loadBar.translation" />
    </Animation>
    <Animation id="hazeIn" duration="0.35" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="haze.opacity" />
    </Animation>
    <Animation id="snowSettle" duration="0.7" repeat="false" easeFunction="inOutQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.32, 0.14]" fieldToInterp="snow.opacity" />
    </Animation>
    <Group id="panel">
      <Rectangle width="1180" height="555" color="0x0B0B1CFF" />
      <!-- TunerView's NavBar logo: the brand wordmark (scripts/icons.sh). -->
      <Poster id="logo" uri="pkg:/images/logo.png" translation="[40,54]" width="363" height="48" />
      <!-- TunerView's nav item: Up from the top row focuses it. -->
      <Label id="navSettings" text="SETTINGS" translation="[924,64]" width="200" horizAlign="right" />
      <!-- UPDATING LIBRARY and GUIDE READY, in the header beside the logo. -->
      <Label id="headerNote" text="" translation="[440,66]" width="470" visible="false" />
      <!-- While a package switched on in Settings is still building: its
           channels are on the way (Discussion #8). -->
      <Label id="buildNotice" text="" translation="[40,128]" width="1100" visible="false" />
      <Group id="info" translation="[40,204]">
        <!-- Letter-spaced text is a Label per character (VT323 is monospace). -->
        <Group id="tag" />
        <Rectangle id="posterBack" translation="[0,56]" width="120" height="180" color="0xFFFFFF0A" visible="false" />
        <Poster id="poster" translation="[0,56]" width="120" height="180" loadDisplayMode="scaleToFill" visible="false" />
        <Label id="title" translation="[0,56]" width="1100" wrap="true" maxLines="2" lineSpacing="2" />
        <Label id="artist" width="1100" />
        <Label id="genres" width="1100" wrap="true" maxLines="2" />
        <Label id="subtitle" width="1100" />
        <Rectangle id="rule" width="1100" height="1" />
        <Label id="summary" width="1100" wrap="true" maxLines="2" lineSpacing="4" />
        <Group id="meta">
          <Group id="badges" />
        </Group>
        <Group id="progressRow">
          <Rectangle id="progressTrack" height="4" color="0xFFFFFF14" />
          <Rectangle id="progressFill" height="4" />
          <Label id="clock" />
        </Group>
        <Group id="upNextLabel" />
        <Label id="upNext" width="1000" />
      </Group>
    </Group>
    <Group id="grid" translation="[0,555]">
      <Rectangle width="1920" height="525" color="0x0D0D1FFF" />
      <Rectangle id="headerBg" width="1920" height="58" color="0x0A0A14FF" />
      <Label id="channelHead" text="CHANNEL" translation="[12,18]" />
      <Group id="slots" />
      <Rectangle id="headerRule" translation="[0,58]" width="1920" height="1" color="0xFFFFFF40" />
      <Group id="rows" translation="[0,59]" clippingRect="[0,0,1920,466]" />
      <Rectangle id="nowLine" width="2" height="525" color="0x00D4FFFF" />
      <!-- The empty guide area's one block while the library loads or the
           guide is changing: title, progress, indicator, and the Settings note. -->
      <Group id="loadBlock" translation="[0,59]" visible="false">
        <Rectangle id="loadBg" width="1920" height="466" color="0x0D0D1FFF" />
        <Label id="loadTitle" text="" translation="[160,110]" width="1600" horizAlign="center" />
        <Label id="loadLine" text="" translation="[360,166]" width="1200" horizAlign="center" wrap="true" maxLines="3" lineSpacing="4" />
        <Label id="loadLib" text="" translation="[360,202]" width="1200" horizAlign="center" />
        <Group id="loadInd" translation="[780,250]">
          <Rectangle id="loadTrack" width="360" height="4" color="0xFFFFFF14" />
          <Group id="loadClip" clippingRect="[0,0,360,4]">
            <Rectangle id="loadBar" width="120" height="4" color="0x00D4FFFF" />
          </Group>
        </Group>
        <Label id="loadNote" text="" translation="[360,276]" width="1200" horizAlign="center" />
      </Group>
    </Group>
    <Group id="sidebar" translation="[0,555]" visible="false" />
    <!-- Full screen's channel OSD (PlayerView ChannelOSD), bottom left. -->
    <Group id="osd" visible="false" />
    <!-- The seasonal invite's question (ChannelGuideView's confirmationDialog). -->
    <Group id="prompt" visible="false" />
    <Label id="ccToast" visible="false" translation="[1460,60]" width="400" horizAlign="right" />
    <!-- The sleep timer's STILL WATCHING? prompt (SleepGracePrompt). -->
    <Group id="grace" visible="false">
      <Rectangle width="1920" height="1080" color="0x000000CC" />
      <Rectangle translation="[580,420]" width="760" height="240" color="0x0D0D12FF" />
      <Rectangle translation="[580,420]" width="760" height="1" color="0xFFFFFF47" />
      <Rectangle translation="[580,659]" width="760" height="1" color="0xFFFFFF47" />
      <Rectangle translation="[580,420]" width="1" height="240" color="0xFFFFFF47" />
      <Rectangle translation="[1339,420]" width="1" height="240" color="0xFFFFFF47" />
      <Label id="graceTitle" text="STILL WATCHING?" translation="[580,464]" width="760" horizAlign="center" />
      <Label id="graceCount" text="" translation="[580,524]" width="760" horizAlign="center" />
      <Label id="graceHint" text="PRESS ANY BUTTON TO KEEP WATCHING" translation="[580,580]" width="760" horizAlign="center" />
    </Group>
    <Label id="notice" translation="[1200,500]" width="700" wrap="true" color="0xFF6B6BFF" />
    <!-- PlaybackFailureCard: why a programme won't play, over the video,
         amber for the server and red for the file or the TV. Nothing in
         it takes focus; positionCard sizes it to the text. -->
    <Group id="failCard" visible="false">
      <Rectangle id="failEdge" />
      <Rectangle id="failBg" color="0x000000D1" />
      <Label id="failHead" horizAlign="center" wrap="true" />
      <Label id="failDetail" horizAlign="center" wrap="true" lineSpacing="4" />
      <Label id="failNext" horizAlign="center" />
    </Group>
  </children>
</component>
