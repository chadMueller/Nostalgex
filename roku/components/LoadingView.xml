<?xml version="1.0" encoding="utf-8"?>
<!-- The progress screen of a library load, as upstream's LoadingView and
     LibraryLoadStepRail (App/Plex90App.swift): the logo, the first-run
     warning, the step rail, the step's headline, a detail line and a bar.
     It reads everything from the LibraryTask it is given. stalling, set by
     MainScene's stall watch, adds upstream's STOP WAITING block; OK on it
     goes to MainScene, which holds the focus. START OVER sits under it all
     for the whole load, as upstream's: * arms it (startOverArmed, set by
     MainScene), and a second * signs out. -->
<component name="LoadingView" extends="Group">
  <interface>
    <field id="task" type="node" onChange="onTask" />
    <field id="stalling" type="boolean" value="false" onChange="render" />
    <!-- The library step's headline, for the kind being scanned. -->
    <field id="scanHeadline" type="string" value="" />
    <!-- START OVER asked for once; the next * signs out (MainScene). -->
    <field id="startOverArmed" type="boolean" value="false" onChange="renderStartOver" />
    <!-- Who START OVER signs out of: Plex, Jellyfin or Emby. -->
    <field id="serverName" type="string" value="" onChange="renderStartOver" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util/Values.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/LoadingNote.brs" />
  <script type="text/brightscript" uri="pkg:/components/LoadingView.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Group id="content" />
    <Group id="startOver" />
    <!-- Holds the screensaver off for as long as the loading screen is up.
         The Roku pauses the whole app under its screensaver, the scan with
         it: a load longer than the TV's wait (10 min on our 43S45, Roku OS
         16.0.4) sat paused, and the stall watch stopped it on waking
         (2026-11-04). A Video node's
         disableScreenSaver is the Roku's switch for it; this one never gets
         content, as upstream's isIdleTimerDisabled while loading
         (ScreenAwakePolicy.swift). -->
    <Video id="screensaverHold" visible="false" width="0" height="0" disableScreenSaver="true" />
  </children>
</component>
