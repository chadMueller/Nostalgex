<?xml version="1.0" encoding="utf-8"?>
<!-- Signs in to Plex with a plex.tv/link code, or (mode "password") this
     TV's own email and password straight to plex.tv (Roku certification
     rule 2.2: on-device authentication). Either way finds the account's
     servers once signed in; their addresses are checked later, by the
     library task, for the servers that are on. No field carries a token:
     tokens stay in the registry (see source/plex/PlexApi.brs), and
     `password` is cleared the moment the request that uses it is sent. -->
<component name="PlexSignInTask" extends="Task">
  <interface>
    <!-- "" (the link code, the default) or "password". -->
    <field id="mode" type="string" value="" />
    <!-- checking | code | discovering | ready | error. Not "state": every Task has a built-in field of that name. -->
    <field id="status" type="string" value="" />
    <field id="code" type="string" value="" />
    <field id="account" type="string" value="" />
    <field id="message" type="string" value="" />
    <!-- mode "password" only. -->
    <field id="email" type="string" value="" />
    <field id="password" type="string" value="" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util/Values.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/PlexApi.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/LibrarySnapshot.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/MediaBrowserApi.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/ServerKind.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/SignInFlow.brs" />
  <script type="text/brightscript" uri="pkg:/components/PlexSignInTask.brs" />
</component>
