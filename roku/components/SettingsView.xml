<?xml version="1.0" encoding="utf-8"?>
<!-- Settings as the Apple TV app's rail and pane (N-028, Views/Settings/):
     a rail down the left with five tabs, SUPPORT NOSTALGEX pinned above a
     divider, then PLAYBACK & PICTURE, CHANNELS & BUNDLES, SERVERS & ACCOUNTS
     and ABOUT; beside it the open tab's hero (icon, title, one line) pinned
     at the top and its rows scrolling under a divider. Up and Down on the
     rail swap the pane with no press; Right or OK goes into the rows; Left
     or Back comes back to the rail; Back on the rail leaves. The rules are
     source/guide/SettingsRail.brs.
     Choices are saved on the TV. A package switch is built at once, behind
     Settings, building only that package's channels; a franchise,
     collection or server change rebuilds the guide when Settings closes.
     Moving between tabs saves and rebuilds nothing. -->
<component name="SettingsView" extends="Group">
  <interface>
    <field id="bundles" type="array" />
    <!-- The ids of the channels on air and the packages the guide was built
         with, for the amber count on a package short of content. -->
    <field id="onAirIds" type="array" />
    <field id="builtBundles" type="array" />
    <!-- The franchise list under FRANCHISES, from the last guide build. -->
    <field id="franchises" type="array" />
    <field id="franchiseOverCap" type="integer" />
    <field id="franchiseCapacity" type="integer" />
    <!-- MY COLLECTIONS from the last guide build: { rows, overCap, scanned, failed }. -->
    <field id="collections" type="assocarray" />
    <!-- Set when Settings closes: "close", "rebuild" or "signOut". -->
    <field id="result" type="string" alwaysNotify="true" />
    <!-- Set when a package switch has been saved, to have it built now. -->
    <field id="bundleChange" type="boolean" alwaysNotify="true" />
    <!-- OK on RESCAN LIBRARY; rescanning is true while a library load runs
         (GuideView.libraryBusy), when the row says UPDATING. -->
    <field id="rescan" type="boolean" alwaysNotify="true" />
    <field id="rescanning" type="boolean" value="false" onChange="onRescanning" />
    <!-- The library task's answer: the packages built, as JSON, or "rebuild". -->
    <field id="bundleBuilt" type="string" alwaysNotify="true" onChange="onBundleBuilt" />
    <!-- Each channel's matching titles, for WHY ARE SOME CHANNELS MISSING?
         (#227): the library task's matchCounts, { state, byId }. -->
    <field id="matchCounts" type="assocarray" onChange="onMatchCounts" />
    <function name="open" />
    <function name="refreshRows" />
    <!-- The packages still building, for the guide to keep saying so once
         Settings closes, and to hand back when it opens again. -->
    <function name="buildingIds" />
    <function name="setBuilding" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util/Values.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/QrCode.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/StreamQuality.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/AppVersion.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/SeasonalPrompt.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/BundleChoices.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/SettingsChannels.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/ChannelsMissing.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/SettingsRail.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/AboutLinks.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/PlexApi.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/RescanInfo.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/ServerChoice.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/ServerKind.brs" />
  <script type="text/brightscript" uri="pkg:/source/subtitles/SubtitleSelection.brs" />
  <script type="text/brightscript" uri="pkg:/source/subtitles/SubtitleSettings.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/PlaybackReport.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/RetroMode.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/Watershed.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/GuideText.brs" />
  <script type="text/brightscript" uri="pkg:/source/ui/Tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/FranchiseChoices.brs" />
  <script type="text/brightscript" uri="pkg:/source/collections/CollectionChoices.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/LastChannel.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/HiddenLibraries.brs" />
  <script type="text/brightscript" uri="pkg:/components/SettingsView.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x0B0B1CFF" />
    <!-- The rail (0 to 420) and the pane's content, 60 in from its edge. -->
    <Group id="rail" />
    <Group id="pane" translation="[480,0]" />
  </children>
</component>
