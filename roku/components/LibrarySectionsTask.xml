<?xml version="1.0" encoding="utf-8"?>
<!-- The library sections on the signed-in servers, asked for before the first
     scan so the viewer can turn some off (I-092, the Apple TV's
     LibrarySelection). A Plex server is checked first, as the library task
     does, and Jellyfin and Emby are asked twice, plain and with the hidden
     libraries, so the ones the viewer hides on the server are marked. Nothing
     it reads is kept except the sections themselves and the resolved
     addresses the library task would resolve anyway. -->
<component name="LibrarySectionsTask" extends="Task">
  <interface>
    <!-- "" until done, then "done": sections holds [{ serverId, serverName, key, title, type, hidden }]
         (empty when the servers could not be asked: the picker is then skipped). -->
    <field id="status" type="string" value="" alwaysNotify="true" />
    <field id="sections" type="array" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util/Values.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/PlexApi.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/ServerChoice.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/ServerResolve.brs" />
  <script type="text/brightscript" uri="pkg:/source/plex/PlexLibrary.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/MediaBrowserApi.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/MediaBrowserLibrary.brs" />
  <script type="text/brightscript" uri="pkg:/source/mediabrowser/ServerKind.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/LibrarySections.brs" />
  <script type="text/brightscript" uri="pkg:/components/LibrarySectionsTask.brs" />
</component>
