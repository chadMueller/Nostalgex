<?xml version="1.0" encoding="utf-8"?>
<!-- Full screen's Now Playing panel, Down from bare playback, as upstream's
     NowPlayingPanel (Views/NowPlayingPanel.swift): what is on at the left,
     two columns of controls at the right. It only draws and reports: the
     guide does what a row asks and sends the new state back. -->
<component name="NowPlayingView" extends="Group">
  <interface>
    <!-- { number, name, color, nowLine, rating, upNext, poster, hasSubs, ccOn,
         autoOn, audio: [{ name, active }], retro, sleepMinutes,
         sleepLeft (seconds, -1 when off), info: [{ label, value }], infoNote,
         subsLanguage, audioLanguage (saved codes), subsLabel, audioLabel,
         languages: [{ code, label }] } -->
    <field id="state" type="assocarray" onChange="render" />
    <!-- What a row asked for: cc | auto | audio:<n> | retro | sleep:<minutes>
         | subsLanguage:<code> | audioLanguage:<code>. -->
    <field id="action" type="string" alwaysNotify="true" />
    <field id="closed" type="boolean" alwaysNotify="true" />
    <!-- True while PLAYBACK INFORMATION is open: the guide sends its rows
         every second then, as upstream's TimelineView redraws them. -->
    <field id="infoOpen" type="boolean" value="false" />
    <function name="open" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util/Values.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/SleepTimer.brs" />
  <script type="text/brightscript" uri="pkg:/source/ui/Tokens.brs" />
  <script type="text/brightscript" uri="pkg:/source/guide/NowPlayingLayout.brs" />
  <script type="text/brightscript" uri="pkg:/components/NowPlayingView.brs" />
  <children>
    <!-- The panel colour at 96%, as the Apple TV's (#266), fading out over the
         foot of it (the "fade" bands, built in render). -->
    <Rectangle id="shade" width="1920" height="600" color="0x0A0F1EF5" />
    <Group id="fade" />
    <!-- Upstream's poster, 120 by 180 (Variant A, #266), left of the info zone (Plex only):
         a 14% white placeholder until the file comes. -->
    <Rectangle id="posterBack" translation="[90, 60]" width="120" height="180" color="0xFFFFFF24" visible="false" />
    <Poster id="poster" translation="[90, 60]" width="120" height="180" loadDisplayMode="scaleToZoom" visible="false" />
    <Group id="info" />
    <Group id="controls" />
  </children>
</component>
