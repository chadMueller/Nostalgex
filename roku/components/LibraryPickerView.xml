<?xml version="1.0" encoding="utf-8"?>
<!-- CHOOSE YOUR LIBRARIES (I-092, the Apple TV's library selection): after
     sign-in and before the first scan, one row per library section on the
     servers in use, each ON or OFF, every one on to start with except a hidden
     Jellyfin library, one row each, off. A library turned off is never read, which is the
     answer to a very large library on a TV with little memory. Shown only
     when there is more than one section to choose between, or a hidden one. -->
<component name="LibraryPickerView" extends="Group">
  <interface>
    <!-- [{ serverId, serverName, key, title, type, hidden }]. -->
    <field id="sections" type="array" onChange="render" />
    <!-- Set once, on CONTINUE: { off: { "serverID::key": true } for every library turned off,
         included: { "serverID::key": true } for every hidden Jellyfin library turned on }. -->
    <field id="choices" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/util/Values.brs" />
  <script type="text/brightscript" uri="pkg:/source/util/LibrarySections.brs" />
  <script type="text/brightscript" uri="pkg:/components/LibraryPickerView.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Group id="left" />
    <Group id="list" />
    <Group id="cont" />
  </children>
</component>
