' EPISODE ORDER (I-103): source/schedule/DailyManifest.brs's CLASSIC RERUNS and SHUFFLE against the engine's own answers
' for fixture C in tests/vectors/schedule.json (generated by tests/gen-vectors.mjs from scripts/nostalgex-daily-manifest.js),
' then the port's own seams: the saved choice, the words, the keys a change of order has to move. The Apple TV's answers
' for whole lineups are tests/ScheduleParityGoldenTests.brs over scripts/schedule-parity-golden.json and
' scripts/episode-order-golden.json. Returns the failure count.

function NxRunEpisodeOrderTests(vectorsPath as String) as Integer
    v = ParseJson(ReadAsciiFile(vectorsPath))
    if v = invalid then
        print "FAIL cannot read "; vectorsPath
        return 1
    end if
    r = { pass: 0, fail: 0 }
    e = v.episodeOrder
    pool = v.fixtures.C.pool
    NxSetEpisodeOrder("classic")

    ' The tag as the engine reads it.
    for each tag in e.seTags
        n = NxSeriesNumber({ seTag: tag })
        got = "none"
        if n <> invalid then got = n.season.ToStr() + "x" + n.episode.ToStr()
        NxCheck(r, "tag '" + tag + "'", got, e.seTags[tag])
    end for
    ' An item the loaders made has its numbers, not a tag: S01E04, E04, S02, and nothing for 0 or none.
    NxCheck(r, "loader item: season and episode", NxEpisodeTag({ seasonNumber: 1, episodeNumber: 4 }), "S01E04")
    NxCheck(r, "loader item: episode only", NxEpisodeTag({ episodeNumber: 4 }), "E04")
    NxCheck(r, "loader item: season only", NxEpisodeTag({ seasonNumber: 2 }), "S02")
    NxCheck(r, "loader item: a season 0 says nothing", NxEpisodeTag({ seasonNumber: 0, episodeNumber: 3 }), "E03")
    NxCheck(r, "loader item: no numbers", NxEpisodeTag({ seasonNumber: invalid, episodeNumber: invalid }), "")
    NxCheck(r, "loader item: three digit episode keeps its digits", NxEpisodeTag({ seasonNumber: 12, episodeNumber: 104 }), "S12E104")
    NxCheck(r, "a tag on the item wins, even an empty one", NxEpisodeTag({ seTag: "", seasonNumber: 1, episodeNumber: 1 }), "")

    ' Which show an item belongs to.
    byKey = {}
    for each it in pool
        byKey[it.ratingKey] = it
    end for
    for each k in e.identity
        NxCheck(r, "identity " + k, NxShowIdentity(byKey[k]), e.identity[k])
    end for
    NxCheck(r, "identity: year 0 is no year", NxShowIdentity({ type: "episode", title: "X", year: 0 }), "title_X|")
    NxCheck(r, "identity: a title is kept in its case", FormatJson(NxSameIdentity("title_The Wire|", "title_the wire|")), "false")

    ' One show, in series order, without second copies.
    NxCheck(r, "series order: Alpha", NxEoIds(NxInSeriesOrder(NxEoShow(pool, "Alpha"))), e.series.alpha)
    NxCheck(r, "series order: Bravo, the numbered first, the untagged last", NxEoIds(NxInSeriesOrder(NxEoShow(pool, "Bravo"))), e.series.bravo)
    NxCheck(r, "second copies: Echo", NxEoIds(NxWithoutSecondCopies(NxEoShow(pool, "Echo"))), e.dedupe.echo)
    NxCheck(r, "second copies: a tag without a season is no copy", NxEoIds(NxWithoutSecondCopies([{ ratingKey: "x1", type: "episode", seTag: "E01" }, { ratingKey: "x2", type: "episode", seTag: "E01" }])), "x1,x2")
    NxCheck(r, "second copies: a film never is", NxEoIds(NxWithoutSecondCopies([{ ratingKey: "m1", type: "movie" }, { ratingKey: "m2", type: "movie" }])), "m1,m2")

    ' What follows what.
    NxCheck(r, "next: the pool", NxEoMap(NxSeriesNext(pool)), e.next.pool)
    films = []
    for each it in pool
        if it.type = "movie" then films.Push(it)
    end for
    NxCheck(r, "next: films have none", NxEoMap(NxSeriesNext(films)), e.next.film)

    ' The day's ordering, under each order.
    for each key in e.interleave
        f = key.Split(":")
        follows = invalid
        if f[0] = "classic" then follows = NxSeriesNext(pool)
        got = NxInterleaveByShow(pool, f[1].ToInt(), f[2].ToInt(), f[0], follows)
        NxCheck(r, "interleave " + key, NxEoIds(got), e.interleave[key])
        if follows <> invalid then
            ' Handing no `follows` gives the same day: the whole list is the pool.
            NxCheck(r, "interleave " + key + ", follows from the list", NxEoIds(NxInterleaveByShow(pool, f[1].ToInt(), f[2].ToInt(), f[0])), e.interleave[key])
        end if
    end for
    ordC = NxInterleaveByShow(pool, 7, 20732, "classic", NxSeriesNext(pool))
    NxCheck(r, "pairs: classic", NxEoMap(NxPairsIn(ordC, NxSeriesNext(pool))), NxEoSorted(e.pairs.classic))
    ' Shuffle: every title once, no film lost, and the two second copies in Echo (e1b, e2b) not at all.
    shuffled = NxInterleaveByShow(pool, 7, 20732, "shuffle")
    NxCheck(r, "shuffle: every title once, second copies left out", shuffled.Count().ToStr(), (pool.Count() - 2).ToStr())

    ' pickCandidate's two new rules.
    for each c in e.pick
        queue = []
        for each k in c.queue
            queue.Push(byKey[k])
        end for
        avoidShow = c.avoidShow
        avoidKey = c.avoidKey
        got = NxPickCandidate(queue, 0, invalid, 1, avoidKey, false, false, c.keepShowOrder, avoidShow)
        NxCheck(r, "pick: " + c.name, got.ToStr(), c.want.ToStr())
    end for

    ' Whole days, under each order.
    for each c in e.packDay
        NxSetEpisodeOrder(c.order)
        aired = {}
        aired.SetModeCaseSensitive()
        for each k in c.aired
            aired[k] = true
        end for
        got = NxPackDay(pool, c.dayStart, c.dayEnd, c.day, c.channel, aired, false, c.last)
        parts = []
        for each b in got
            parts.Push(b.ratingKey + "@" + b.startSec.ToStr() + "-" + b.endSec.ToStr())
        end for
        NxCheck(r, "packDay " + c.name, parts.Join(","), c.blocks)
    end for

    ' The saved choice, the words, and what a change of order moves.
    NxSetEpisodeOrder("classic")
    NxCheck(r, "order: classic by default", NxEpisodeOrder(), "classic")
    NxCheck(r, "order: next from classic", NxEpisodeOrderNext("classic"), "shuffle")
    NxCheck(r, "order: next from shuffle", NxEpisodeOrderNext("shuffle"), "classic")
    NxCheck(r, "order: the Apple TV's words, classic", NxEpisodeOrderTitle("classic"), "CLASSIC RERUNS")
    NxCheck(r, "order: the Apple TV's words, shuffle", NxEpisodeOrderTitle("shuffle"), "SHUFFLE")
    NxCheck(r, "order: explanation, classic", NxEpisodeOrderExplanation("classic"), "Two episodes of a show back to back, in order. Movie channels are not affected.")
    NxCheck(r, "order: explanation, shuffle", NxEpisodeOrderExplanation("shuffle"), "One episode at a time, picked at random. Movie channels are not affected.")
    fake = NxFakeRegistry()
    NxCheck(r, "order: nothing saved is classic", NxEpisodeOrderSaved(fake), "classic")
    NxSaveEpisodeOrder("shuffle", fake)
    NxCheck(r, "order: saved shuffle", fake.Read("episodeOrder"), "shuffle")
    NxCheck(r, "order: read back", NxEpisodeOrderSaved(fake), "shuffle")
    NxCheck(r, "order: saving takes it for this thread", NxEpisodeOrder(), "shuffle")
    NxSetEpisodeOrder("classic")
    NxCheck(r, "order: a task reads the registry afresh", NxSyncEpisodeOrder(fake), "shuffle")
    NxSaveEpisodeOrder("classic", fake)
    NxCheck(r, "order: classic saves nothing", fake.Read("episodeOrder"), "")
    NxCheck(r, "order: and reads back as classic", NxSyncEpisodeOrder(fake), "classic")
    NxCheck(r, "order: a guide saved before the setting was classic", NxGuideEpisodeOrder({}), "classic")
    NxCheck(r, "order: a guide saved under shuffle", NxGuideEpisodeOrder({ episodeOrder: "shuffle" }), "shuffle")

    valid = []
    for each it in pool
        if it.duration > 0 then valid.Push(it)
    end for
    NxSetEpisodeOrder("classic")
    NxCheck(r, "fingerprint: classic is the engine's", NxPoolFingerprint(valid), e.fingerprint.classic)
    NxSetEpisodeOrder("shuffle")
    NxCheck(r, "fingerprint: shuffle is the engine's", NxPoolFingerprint(valid), e.fingerprint.shuffle)
    memo = {}
    NxSetEpisodeOrder("classic")
    first = NxPoolPrepare(pool, memo).fp
    NxSetEpisodeOrder("shuffle")
    second = NxPoolPrepare(pool, memo).fp
    NxCheck(r, "pool memo: a change of order changes the fingerprint, the memo is not read again", FormatJson([first = e.fingerprint.classic, second = e.fingerprint.shuffle]), "[true,true]")
    NxSetEpisodeOrder("classic")
    at& = 1791262800
    NxCheck(r, "hour key: the order is in it", FormatJson(NxScheduleHourKey(at&, false, "shuffle") <> NxScheduleHourKey(at&, false, "classic")), "true")
    NxCheck(r, "hour key: classic is the old key", NxScheduleHourKey(at&, false, "classic"), NxScheduleHourKey(at&))
    day = "20261028"
    classicKey = NxGuideKeyRest(day, ["nostalgex"], "[]", false, "classic")
    shuffleKey = NxGuideKeyRest(day, ["nostalgex"], "[]", false, "shuffle")
    NxCheck(r, "saved key: a guide saved under classic is not shown under shuffle", FormatJson(NxSavedKeyShowable(NxSavedKey("1.0.7+bbbb", classicKey), NxSavedKey("1.0.7+bbbb", shuffleKey))), "false")
    NxCheck(r, "saved key: nor the other way", FormatJson(NxSavedKeyShowable(NxSavedKey("1.0.7+bbbb", shuffleKey), NxSavedKey("1.0.7+bbbb", classicKey))), "false")
    NxCheck(r, "saved key: the same order, another build, shows", FormatJson(NxSavedKeyShowable(NxSavedKey("1.0.6+aaaa", shuffleKey), NxSavedKey("1.0.7+bbbb", shuffleKey))), "true")
    NxCheck(r, "saved key: a guide saved before the setting is not shown", FormatJson(NxSavedKeyShowable(NxSavedKey("1.0.6+aaaa", day + "|[""nostalgex""]|[]"), NxSavedKey("1.0.7+bbbb", classicKey))), "false")

    ' A manifest packed under one order is packed again under the other (the lineup's session cache keys on the fingerprint).
    NxClearManifests()
    ch = { id: 7, number: 7, name: "CH 7", colorHex: "#FFFFFF", isPremiereChannel: false, pool: pool }
    NxSetLineup([ch])
    NxSetEpisodeOrder("classic")
    asClassic = NxEoDay(ch, 1791262800&)
    NxSetEpisodeOrder("shuffle")
    asShuffle = NxEoDay(ch, 1791262800&)
    NxCheck(r, "manifest: the same day under the other order is another day", FormatJson(asClassic <> asShuffle), "true")
    NxSetEpisodeOrder("classic")
    NxCheck(r, "manifest: and back again", NxEoDay(ch, 1791262800&), asClassic)
    NxClearManifests()
    NxSetLineup(invalid)
    NxSetEpisodeOrder("classic")

    print "episode order cases:"; r.pass; " passed,"; r.fail; " failed"
    return r.fail
end function

function NxEoIds(list as Object) as String
    keys = []
    for each it in list
        keys.Push(it.ratingKey)
    end for
    return keys.Join(",")
end function

' One show's episodes, in the pool's order.
function NxEoShow(pool as Object, title as String) as Object
    out = []
    for each it in pool
        if it.type = "episode" and it.title = title then out.Push(it)
    end for
    return out
end function

function NxEoMap(aa as Object) as String
    parts = []
    for each k in aa
        parts.Push(k + ">" + aa[k])
    end for
    parts.Sort()
    return parts.Join(",")
end function

' The engine's "a>b,c>d" as the sorted form NxEoMap gives.
function NxEoSorted(text as String) as String
    if text = "" then return ""
    parts = text.Split(",")
    parts.Sort()
    return parts.Join(",")
end function

function NxEoDay(ch as Object, at& as LongInteger) as String
    parts = []
    for each b in NxManifestBlocks(ch, ch.pool, at&)
        parts.Push(NxToStr(b.item.ratingKey) + "@" + b.startSec.ToStr())
    end for
    return parts.Join(",")
end function
